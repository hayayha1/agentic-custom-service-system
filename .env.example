# ========================================================
# 智能客服系统模型与环境配置文件示例
# 复制本文件为 .env 并填入您自己的真实 API Key 即可启动
# ========================================================

# 1. 对话生成与 Query 改写 (接入 DeepSeek 官方 API 或 OpenAI 兼容大模型)
OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 2. 文本向量化 Embedding (接入 硅基流动 SiliconFlow 顶级中文向量模型，1024维)
EMBEDDING_API_KEY=your_siliconflow_api_key_here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024

# 3. 语义重排 Rerank (接入 硅基流动 SiliconFlow Cross-Encoder 模型)
RERANK_API_KEY=your_siliconflow_api_key_here
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 4. 数据库配置 (默认本地轻量 SQLite，可无缝切至 PostgreSQL pgvector)
DATABASE_URL=sqlite+aiosqlite:///./knowledge_base.db

# 5. Agent 持久化与执行边界（SQLite 本地直接可用）
# 生产部署改为共享 PostgreSQL：postgresql+asyncpg://user:password@host/agent
AGENT_DATABASE_URL=sqlite+aiosqlite:///./agent_state.db
# 可选 Redis 热缓存；未配置时由 SQL 承担全部持久化，Redis 故障时回读 SQL
# AGENT_REDIS_URL=redis://localhost:6379/1
AGENT_MAX_ITERATIONS=8
AGENT_TIMEOUT_SECONDS=60
AGENT_MEMORY_TTL_SECONDS=86400
AGENT_MEMORY_WINDOW=5
AGENT_CONTEXT_TOKENS=3000
AGENT_TOOL_TIMEOUT_SECONDS=10
AGENT_TOOL_RETRIES=3
AGENT_TOOL_RATE_LIMIT=20
AGENT_CIRCUIT_THRESHOLD=5
AGENT_CIRCUIT_RESET_SECONDS=60
# 可选 OpenTelemetry HTTP Trace Collector，兼容支持 OTLP 的观测平台
# AGENT_OTLP_ENDPOINT=http://localhost:4318/v1/traces
